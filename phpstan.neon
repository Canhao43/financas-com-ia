includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Lê o corpo do casts() dos models: sem isso, enum e data viram string para a análise.
    parseModelCastsMethod: true
