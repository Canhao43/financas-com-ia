# Copie para o servidor como .env, ao lado do compose.yaml. Este arquivo tem segredo:
# fica só no servidor (chmod 600), nunca no Git.
#
# O resto da configuração de produção (banco em /dados, logs, cookie seguro) já vem na imagem.

APP_NAME="Finanças com IA"
# Gere com: docker run --rm ghcr.io/canhao43/financas-com-ia php artisan key:generate --show
APP_KEY=

# O domínio, sem https://. O Caddy pede o certificado para este nome.
SERVER_NAME=financas.exemplo.com.br
APP_URL=https://financas.exemplo.com.br

# Backup: chave pública do age e destino do rclone (ver docs/deploy.md).
BACKUP_CHAVE_PUBLICA=age1...
BACKUP_DESTINO=gdrive:financas-backups
