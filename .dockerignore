# A imagem é pública no GHCR: nada de dado, segredo ou sobra local entra nela.
.git
.github
.env
.env.*
**/*.sqlite
**/*.sqlite-*
**/*.ofx
**/*.qfx

# Gerados no build, dentro da imagem.
node_modules
vendor
public/build
public/hot
bootstrap/cache/*.php
resources/js/actions
resources/js/routes
resources/js/wayfinder

storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing
storage/app/*
storage/pail

# Não rodam em produção.
tests
docs
deploy
*.md
.phpunit.cache
.phpunit.result.cache
.claude
.agents
